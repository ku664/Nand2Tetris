// Hack Memory — maps RAM16K (0..16383), Screen (16384..24575), and Keyboard (24576).
// Author: Kuber Sharma (Roll No. 2501730446)
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Upper two address bits select the memory region:
    // 00, 01 -> RAM16K | 10 -> Screen | 11 -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=loadRamLo, b=loadRamHi, c=loadScreen, d=loadKbd);
    Or(a=loadRamLo, b=loadRamHi, out=loadRam);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
